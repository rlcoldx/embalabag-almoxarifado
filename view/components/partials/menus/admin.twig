{% include 'components/partials/menus/_menu_state.twig' %}
{% if menu_permissions.users or menu_permissions.cargos or menu_permissions.permissoes or menu_permissions.log_acessos %}
<!-- Start::slide__category -->
<li class="slide__category"><span class="category-name">Usuários</span></li>
<!-- End::slide__category -->

<!-- Start::slide -->
<li class="slide has-sub {{ users_open ? 'active open' : '' }}">
    <a href="javascript:void(0);" class="side-menu__item">
        <i class="fa-light fa-users side-menu__icon"></i>
        <span class="side-menu__label">Gerenciar Usuários</span>
        <i class="fa-light fa-chevron-right side-menu__angle"></i>
    </a>
    <ul class="slide-menu">
        {% if menu_permissions.users %}
        <li class="slide {{ menu and menu == 'users' ? 'active open' : '' }}">
            <a href="{{ DOMAIN }}/users" class="side-menu__item">
                <i class="fa-light fa-list side-menu__icon"></i>
                <span class="side-menu__label">Lista de Usuários</span>
            </a>
        </li>
        {% endif %}
        {% if menu_permissions.cargos %}
        <li class="slide {{ menu and menu == 'cargos' ? 'active open' : '' }}">
            <a href="{{ DOMAIN }}/cargos" class="side-menu__item">
                <i class="fa-light fa-briefcase side-menu__icon"></i>
                <span class="side-menu__label">Gerenciar Cargos</span>
            </a>
        </li>
        {% endif %}
        {% if menu_permissions.permissoes %}
        <li class="slide {{ menu and menu == 'permissoes' ? 'active open' : '' }}">
            <a href="{{ DOMAIN }}/permissoes" class="side-menu__item">
                <i class="fa-light fa-key side-menu__icon"></i>
                <span class="side-menu__label">Permissões</span>
            </a>
        </li>
        {% endif %}
        {% if menu_permissions.log_acessos %}
        <li class="slide {{ menu and menu == 'log_acessos' ? 'active open' : '' }}">
            <a href="{{ DOMAIN }}/log-acessos" class="side-menu__item">
                <i class="fa-light fa-clock-rotate-left side-menu__icon"></i>
                <span class="side-menu__label">Log de Acessos</span>
            </a>
        </li>
        {% endif %}
    </ul>
</li>
<!-- End::slide -->
{% endif %}

