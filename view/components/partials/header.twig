{# Adaptado de header.html do Ynex #}
<!-- Header --> 

<!-- app-header -->
<header class="app-header">
    <!-- Start::main-header-container -->
    <div class="main-header-container container-fluid">
        <!-- Start::header-content-left -->
        <div class="header-content-left">
            <!-- Start::header-element -->
            <div class="header-element">
                <div class="horizontal-logo">
                    <a href="{{ DOMAIN }}" class="header-logo">
                        <img src="{{ PATH }}/view/assets/ynex/assets/images/brand-logos/logo-on-light.svg" alt="logo" class="desktop-logo">
                        <img src="{{ PATH }}/view/assets/ynex/assets/images/brand-logos/logo-on-light.svg" alt="logo" class="toggle-logo">
                        <img src="{{ PATH }}/view/assets/ynex/assets/images/brand-logos/logo.svg" alt="logo" class="desktop-dark">
                        <img src="{{ PATH }}/view/assets/ynex/assets/images/brand-logos/logo.svg" alt="logo" class="toggle-dark">
                        <img src="{{ PATH }}/view/assets/ynex/assets/images/brand-logos/logo.svg" alt="logo" class="desktop-white">
                        <img src="{{ PATH }}/view/assets/ynex/assets/images/brand-logos/logo.svg" alt="logo" class="toggle-white">
                    </a>
                </div>
            </div>
            <!-- End::header-element -->
            <!-- Start::header-element -->
            <div class="header-element">
                <!-- Start::header-link -->
                <a aria-label="Hide Sidebar" class="sidemenu-toggle header-link animated-arrow hor-toggle horizontal-navtoggle" data-bs-toggle="sidebar" href="javascript:void(0);"><span></span></a>
                <!-- End::header-link -->
            </div>
            <!-- End::header-element -->
        </div>
        <!-- End::header-content-left -->
        {% include 'components/partials/header-acoes.twig' %}
        <!-- Start::header-content-right -->
        <div class="header-content-right">
            <!-- Start::header-element -->
            <div class="header-element header-theme-mode">
                <!-- Start::header-link|layout-setting -->
                <a href="javascript:void(0);" class="header-link layout-setting" title="Alternar tema claro e escuro" aria-label="Alternar tema claro e escuro">
                    <span class="light-layout">
                        <!-- Start::header-link-icon -->
                    <i class="bx bx-moon header-link-icon"></i>
                        <!-- End::header-link-icon -->
                    </span>
                    <span class="dark-layout">
                        <!-- Start::header-link-icon -->
                    <i class="bx bx-sun header-link-icon"></i>
                        <!-- End::header-link-icon -->
                    </span>
                </a>
                <!-- End::header-link|layout-setting -->
            </div>
            <!-- End::header-element -->
            <!-- Start::header-element -->
            <div class="header-element">
                <!-- Start::header-link|dropdown-toggle -->
                <a href="javascript:void(0);" class="header-link dropdown-toggle" id="mainHeaderProfile" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <div class="d-flex align-items-center">
                        <div class="me-sm-2 me-0">
                            {% set nome = session[BASE ~ 'user_nome'] %}
                            {% set tipo = session[BASE ~ 'user_tipo'] %}
                            
                            {# Gerar iniciais #}
                            {% set nomes = nome|split(' ') %}
                            {% set iniciais = '' %}
                            {% for nome_parte in nomes %}
                                {% if nome_parte|length > 0 %}
                                    {% set iniciais = iniciais ~ nome_parte|first %}
                                {% endif %}
                            {% endfor %}
                            {% set iniciais = iniciais|upper|slice(0, 2) %}
                            
                            {# Gerar cor baseada no nome #}
                            {% set cores = ['bg-primary', 'bg-secondary', 'bg-success', 'bg-info', 'bg-warning', 'bg-danger', 'bg-dark', 'bg-purple', 'bg-pink', 'bg-indigo'] %}
                            {% set hash = nome|length %}
                            {% set cor_index = hash % cores|length %}
                            {% set cor_avatar = cores[cor_index] %}
                            
                            <span class="avatar avatar-sm avatar-rounded {{ cor_avatar }} d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <span class="text-white fw-semibold fs-12">{{ iniciais }}</span>
                            </span>
                        </div>
                        <div class="d-sm-block d-none">
                            {# Gerar nome de exibição #}
                            {% set nome_exibicao = nomes[0] %}
                            {% if nomes|length > 1 %}
                                {% set nome_exibicao = nome_exibicao ~ ' ' ~ nomes[1]|first ~ '.' %}
                            {% endif %}
                            
                            {# Gerar tipo de usuário #}
                            {% set tipo_texto = 'Usuário' %}
                            {% if tipo == '1' %}
                                {% set tipo_texto = 'Administrador' %}
                            {% elseif tipo == '2' %}
                                {% set tipo_texto = 'Funcionário' %}
                            {% elseif tipo == '3' %}
                                {% set tipo_texto = 'Companhia' %}
                            {% endif %}
                            
                            <p class="fw-semibold mb-0 lh-1">{{ nome_exibicao }}</p>
                            <span class="op-7 fw-normal d-block fs-11">{{ tipo_texto }}</span>
                        </div>
                    </div>
                </a>
                <!-- End::header-link|dropdown-toggle -->
                <ul class="main-header-dropdown dropdown-menu pt-0 overflow-hidden header-profile-dropdown dropdown-menu-end" aria-labelledby="mainHeaderProfile">
                    <li><a class="dropdown-item d-flex" href="{{ DOMAIN }}/logout"><i class="ti ti-logout fs-18 me-2 op-7"></i>Sair</a></li>
                </ul>
            </div>  
            <!-- End::header-element -->
        </div>
        <!-- End::header-content-right -->
    </div>
    <!-- End::main-header-container -->
</header>
<!-- /app-header --> 