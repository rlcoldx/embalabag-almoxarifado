<!-- Modal de Nova Entrada -->
<div class="modal fade" id="modalNovaEntrada" aria-labelledby="modalNovaEntradaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNovaEntradaLabel">
                    <i class="fas fa-plus-circle me-2 text-success"></i>
                    Nova Entrada de Estoque
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formNovaEntrada">
                    <input type="hidden" id="entradaArmazenagemId" name="armazenagem_id">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="entradaProduto" class="form-label required">Produto (SKU)</label>
                                <select class="form-control select2-ajax" id="entradaProduto" name="id_produto" 
                                        data-placeholder="Digite para buscar o produto..." required>
                                    <option value=""></option>
                                </select>
                                <small class="form-hint">Digite o nome ou SKU do produto para buscar</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="entradaVariacao" class="form-label required">Variação</label>
                                <select class="form-control" id="entradaVariacao" name="variacao_id" required disabled>
                                    <option value="">Selecione primeiro o produto</option>
                                </select>
                                <small class="form-hint">Tamanho, cor ou variação do produto</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="entradaQuantidade" class="form-label required">Quantidade</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="entradaQuantidade" name="quantidade" 
                                           min="1" required>
                                    <span class="input-group-text">unidades</span>
                                </div>
                                <small class="form-hint">Quantidade a adicionar ao estoque</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="entradaEstoqueAtual" class="form-label">Estoque Atual</label>
                                <input type="text" class="form-control" id="entradaEstoqueAtual" readonly>
                                <small class="form-hint">Quantidade atual na variação selecionada</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="entradaMotivo" class="form-label">Motivo da Entrada</label>
                                <select class="form-control" id="entradaMotivo" name="motivo">
                                    <option value="">Selecione o motivo</option>
                                    <option value="recebimento">Recebimento de Fornecedor</option>
                                    <option value="devolucao">Devolução de Cliente</option>
                                    <option value="transferencia">Transferência de Outro Armazém</option>
                                    <option value="ajuste">Ajuste de Inventário</option>
                                    <option value="producao">Produção Interna</option>
                                    <option value="outro">Outro</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="entradaDocumento" class="form-label">Documento de Referência</label>
                                <input type="text" class="form-control" id="entradaDocumento" name="documento_referencia" 
                                       placeholder="NF, Pedido, etc.">
                                <small class="form-hint">Número da nota fiscal, pedido ou documento</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="entradaObservacoes" class="form-label">Observações</label>
                        <textarea class="form-control" id="entradaObservacoes" name="observacoes" rows="3" 
                                  placeholder="Observações adicionais sobre a entrada"></textarea>
                    </div>
                    
                    <!-- Informações do Produto -->
                    <div id="infoProdutoEntrada" class="alert alert-info" style="display: none;">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Produto:</strong> <span id="infoNomeProdutoEntrada"></span><br>
                                <strong>Categoria:</strong> <span id="infoCategoriaEntrada"></span><br>
                                <strong>SKU:</strong> <span id="infoSkuEntrada"></span>
                            </div>
                            <div class="col-md-6">
                                <strong>Marca:</strong> <span id="infoMarcaEntrada"></span><br>
                                <strong>Material:</strong> <span id="infoMaterialEntrada"></span><br>
                                <strong>Valor Unitário:</strong> <span id="infoValorEntrada"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary text-black" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary text-black" onclick="salvarEntrada()">
                    <i class="fas fa-plus me-2"></i>Registrar Entrada
                </button>
            </div>
        </div>
    </div>
</div>
<script>
/**
* Salvar entrada de estoque
*/
function salvarEntrada() {
    try {
        // Validar formulário
        const form = document.getElementById('formNovaEntrada');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        
        // Coletar dados do formulário
        const formData = new FormData(form);
        
        // Pegar o variacao_id e id_produto corretos do select
        const variacaoSelect = document.querySelector('#modalNovaEntrada select[name="variacao_id"]');
        const selectedOption = variacaoSelect.options[variacaoSelect.selectedIndex];
        const variacaoId = selectedOption ? selectedOption.value : '';
        const idProduto = selectedOption ? selectedOption.getAttribute('data-id-produto') : formData.get('id_produto');
        
        const dados = {
            armazenagem_id: formData.get('armazenagem_id'),
            id_produto: idProduto,
            variacao_id: variacaoId,
            quantidade: parseInt(formData.get('quantidade')),
            motivo: formData.get('motivo'),
            documento_referencia: formData.get('documento_referencia'),
            observacoes: formData.get('observacoes'),
            tipo: 'entrada'
        };
        
        // Validar campos obrigatórios
        if (!dados.armazenagem_id || !dados.id_produto || !dados.variacao_id || !dados.quantidade) {
            Swal.fire({
                icon: 'warning',
                title: 'Campos Obrigatórios',
                text: 'Por favor, preencha todos os campos obrigatórios.'
            });
            return;
        }
        
        // Mostrar loading no botão
        const btnSalvar = document.querySelector('#modalNovaEntrada button[onclick="salvarEntrada()"]');
        if (!btnSalvar) {
            return;
        }
        const textoOriginal = btnSalvar.innerHTML;
        btnSalvar.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Salvando...';
        btnSalvar.disabled = true;
        
        // Fazer requisição AJAX
        $.ajax({
            url: buildUrl('/api/movimentacoes/criar'),
            method: 'POST',
            dataType: 'json',
            data: dados,
            success: function(response) {
                if (response.success) {
                    // Sucesso
                    Swal.fire({
                        icon: 'success',
                        title: 'Sucesso!',
                        text: 'Entrada de estoque registrada com sucesso!'
                    });
                    
                    // Fechar modal
                    $('#modalNovaEntrada').modal('hide');
                    
                    // Limpar formulário
                    form.reset();
                    
                    // Recarregar página ou atualizar tabela
                    location.reload();                    
                } else {
                    // Erro da API
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro',
                        text: 'Erro ao salvar entrada: ' + (response.error || 'Erro desconhecido')
                    });
                }
            },
            error: function(xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erro',
                    text: 'Erro ao salvar entrada de estoque. Tente novamente.'
                });
            },
            complete: function() {
                // Restaurar botão
                btnSalvar.innerHTML = textoOriginal;
                btnSalvar.disabled = false;
            }
        });
        
    } catch (error) {
        Swal.fire({
            icon: 'error',
            title: 'Erro',
            text: 'Erro ao processar entrada de estoque. Tente novamente.'
        });
    }
}
</script>