{% extends "layout/layoutMaster.twig" %}
{% block title %}Log de Acessos{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Log de Acessos</p>
        <span class="fs-semibold">Acompanhe logins, saídas e tentativas com falha.</span>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        {% include 'components/partials/datatable.twig' with {
            table_name: 'log_acessos',
            data_url: DOMAIN ~ '/api/log-acessos',
            title: 'Registros de Acesso',
            show_create_button: false
        } %}
    </div>
</div>

{% endblock %}
