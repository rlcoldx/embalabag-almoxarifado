{% extends "layout/layoutMaster.twig" %}

{% block title %}Dashboard de Produtos - EmbalaBag{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ PATH }}/view/assets/css/home.css?v={{ VERSION }}">
{% endblock %}

{% block content %}
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Dashboard de Produtos</p>
        <span class="fs-semibold">Cadastro, publicação e situação do estoque.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/produtos" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-boxes me-2 align-middle d-inline-block"></i>Lista de produtos
        </a>
        <a href="{{ DOMAIN }}/produtos/estoque-baixo" class="btn btn-primary btn-wave">
            <i class="fas fa-exclamation-triangle me-2 align-middle d-inline-block"></i>Estoque baixo
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="card custom-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-rounded bg-primary-transparent me-3">
                        <i class="fas fa-boxes"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-0">{{ stats.produtos.total|number_format(0, ',', '.') }}</h4>
                        <span class="home-card-label">Total de produtos</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="card custom-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-rounded bg-success-transparent me-3">
                        <i class="fas fa-check"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold text-success mb-0">{{ stats.produtos.ativos|number_format(0, ',', '.') }}</h4>
                        <span class="home-card-label">Publicados</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="card custom-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-rounded bg-warning-transparent me-3">
                        <i class="fas fa-pencil"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold text-warning mb-0">{{ stats.produtos.rascunho|number_format(0, ',', '.') }}</h4>
                        <span class="home-card-label">Em rascunho</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="card custom-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-rounded bg-danger-transparent me-3">
                        <i class="fas fa-exclamation-triangle"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold text-danger mb-0">{{ stats.produtos.estoque_baixo|number_format(0, ',', '.') }}</h4>
                        <span class="home-card-label">Estoque baixo</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-chart-pie me-2"></i>Situação do estoque</div>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <span>Variações sem estoque</span>
                    <strong>{{ stats.produtos.sem_estoque|number_format(0, ',', '.') }}</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span>Itens críticos</span>
                    <strong class="text-danger">{{ stats.estoque.critico|number_format(0, ',', '.') }}</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Valor estimado em estoque</span>
                    <strong>R$ {{ stats.estoque.valor_total|number_format(2, ',', '.') }}</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-bolt me-2"></i>Ações</div>
            </div>
            <div class="card-body">
                {% if menu_permissions.produtos_new %}
                <a href="{{ DOMAIN }}/produtos/new" class="btn btn-primary w-100 mb-2">Novo produto</a>
                {% endif %}
                <a href="{{ DOMAIN }}/produtos/estoque-baixo" class="btn btn-outline-danger w-100">Ver produtos com estoque baixo</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
