{% extends "layout/layoutMaster.twig" %}
{% block title %}Nova Transferência - EmbalaBag{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Nova Transferência</p>
        <span class="fs-semibold">Solicite a movimentação de um item entre armazenagens.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/transferencias" class="btn btn-outline-secondary btn-wave">
            <i class="fas fa-arrow-left me-2"></i>Voltar
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-exchange-alt me-2"></i>Dados da Transferência</div>
            </div>
            <div class="card-body">
                <form id="formTransferencia" method="POST" action="{{ DOMAIN }}/transferencias/store">
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label class="form-label">Item <span class="text-danger">*</span></label>
                            <select class="form-select" name="item_id" id="selectItem" required>
                                <option value="">Selecione um item alocado</option>
                                {% for item in itens %}
                                <option value="{{ item.id }}"
                                    data-origem="{{ item.armazenagem_id }}"
                                    data-qty="{{ item.quantidade }}">
                                    {{ item.codigo_produto }} — {{ item.descricao_produto }}
                                    {% if item.armazenagem_codigo %} ({{ item.armazenagem_codigo }}){% endif %}
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Quantidade Disponível</label>
                            <input type="number" class="form-control" id="quantidadeDisponivel" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Quantidade a Transferir <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="quantidade" id="quantidadeTransferencia" min="1" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Armazenagem de Origem <span class="text-danger">*</span></label>
                            <select class="form-select" name="armazenagem_origem" id="selectOrigem" required>
                                <option value="">Selecione a origem</option>
                                {% for armazenagem in armazenagens %}
                                <option value="{{ armazenagem.id }}">
                                    {{ armazenagem.codigo }} — {{ armazenagem.descricao }}
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Armazenagem de Destino <span class="text-danger">*</span></label>
                            <select class="form-select" name="armazenagem_destino" id="selectDestino" required>
                                <option value="">Selecione o destino</option>
                                {% for armazenagem in armazenagens %}
                                <option value="{{ armazenagem.id }}">
                                    {{ armazenagem.codigo }} — {{ armazenagem.descricao }}
                                    {% if armazenagem.capacidade_maxima %}
                                        ({{ armazenagem.capacidade_atual|default(0) }}/{{ armazenagem.capacidade_maxima }})
                                    {% endif %}
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Motivo</label>
                            <select class="form-select" name="motivo">
                                <option value="reorganizacao">Reorganização</option>
                                <option value="otimizacao_espaco">Otimização de espaço</option>
                                <option value="manutencao">Manutenção</option>
                                <option value="outro">Outro</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Observações</label>
                            <textarea class="form-control" name="observacoes" rows="3" placeholder="Observações adicionais"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ DOMAIN }}/transferencias" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Solicitar Transferência
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">Como funciona</div>
            </div>
            <div class="card-body">
                <p class="mb-2">A solicitação fica com status pendente até ser executada ou cancelada.</p>
                <p class="mb-0">Na execução, o item é realocado para a armazenagem de destino.</p>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/armazenagens/transferencias/form.js?v={{ VERSION }}"></script>
{% endblock %}
