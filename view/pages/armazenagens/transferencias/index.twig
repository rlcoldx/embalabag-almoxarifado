{% extends "layout/layoutMaster.twig" %}

{% block title %}Transferências - EmbalaBag{% endblock %}

{% block content %}
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Transferências</p>
        <span class="fs-semibold">Solicite e acompanhe transferências entre armazenagens.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        {% if menu_permissions.recebimento_relatorios or menu_permissions.relatorios %}
        <a href="{{ DOMAIN }}/recebimento/relatorios" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-chart-bar me-2 align-middle d-inline-block"></i>Relatório
        </a>
        {% endif %}
        {% if menu_permissions.transferencias_create or permissions.can.armazenagens.transferir %}
        <a href="{{ DOMAIN }}/transferencias/create" class="btn btn-primary btn-wave">
            <i class="fas fa-plus me-2 align-middle d-inline-block"></i>Nova Transferência
        </a>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        {% include 'components/partials/datatable.twig' with {
            table_name: 'transferencias',
            data_url: DOMAIN ~ '/datatable/transferencias',
            title: 'Lista de Transferências',
            create_url: DOMAIN ~ '/transferencias/create',
            show_create_button: false
        } %}
    </div>
</div>
{% endblock %}
