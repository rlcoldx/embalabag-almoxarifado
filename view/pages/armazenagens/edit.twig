{% extends "layout/layoutMaster.twig" %}

{% block title %}Editar Armazenagem - EmbalaBag{% endblock %}



{% block content %}
<!-- Início::page-header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Editar Armazenagem</p>
        <span class="fs-semibold text-muted">Edite as informações da localização de armazenamento.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/armazenagens" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-arrow-left me-2 align-middle d-inline-block"></i>Voltar para Armazenagens
        </a>
    </div>
</div>
<!-- Fim::page-header -->

<!-- Início::row -->
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header justify-content-between align-items-center">
                <div class="card-title">
                    <i class="fas fa-edit me-2"></i>Editar Armazenagem - {{ armazenagem.codigo }}
                </div>
            </div>
            <div class="card-body">
                <form id="formArmazenagem">
                    <!-- Campo hidden com o ID da armazenagem -->
                    <input type="hidden" name="id" value="{{ armazenagem.id }}">
                    
                    <!-- Localização e Identificação -->
                    <div class="mb-4">
                        <h6 class="mb-3 fw-semibold text-primary">
                            <i class="fas fa-map-marker-alt me-2"></i>Localização e Identificação
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label required">
                                    <i class="fas fa-building text-muted me-1"></i>Corredor
                                </label>
                                <input type="text" class="form-control" name="setor" value="{{ armazenagem.setor }}" required autocomplete="off" placeholder="Ex: A, B, C">
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label mb-0 required">
                                    <i class="fas fa-tag text-muted me-1"></i>Código do Andar
                                </label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" name="codigo" value="A" class="btn-check" id="andarbtn1" {% if armazenagem.codigo == 'A' %}checked{% endif %}>
                                    <label class="btn btn-outline-primary" for="andarbtn1">
                                        Andar A
                                    </label>
                                    <input type="radio" name="codigo" value="B" class="btn-check" id="andarbtn2" {% if armazenagem.codigo == 'B' %}checked{% endif %}>
                                    <label class="btn btn-outline-primary" for="andarbtn2">
                                        Andar B
                                    </label>
                                    <input type="radio" name="codigo" value="C" class="btn-check" id="andarbtn3" {% if armazenagem.codigo == 'C' %}checked{% endif %}>
                                    <label class="btn btn-outline-primary" for="andarbtn3">
                                        Andar C
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label">
                                    <i class="fas fa-box text-muted me-1"></i>Tipo
                                </label>
                                <select class="form-select" name="tipo">
                                    <option value="prateleira">Prateleira</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label required">
                                    <i class="fas fa-layer-group text-muted me-1"></i>Capacidade Máxima
                                </label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="capacidade_maxima" value="{{ armazenagem.capacidade_maxima }}" required min="0" placeholder="0">
                                    <span class="input-group-text">Unidades</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Características -->
                    <div class="mb-4">
                        <h6 class="mb-3 fw-semibold text-primary">
                            <i class="fas fa-info-circle me-2"></i>Características
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-9">
                                <label class="form-label">
                                    <i class="fas fa-file-alt text-muted me-1"></i>Descrição
                                </label>
                                <input type="text" class="form-control" name="descricao" value="{{ armazenagem.descricao }}" autocomplete="off" placeholder="Ex: Prateleira A, Gaveta 01">
                                <small class="form-text text-muted">Nome descritivo da localização</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">
                                    <i class="fas fa-toggle-on text-muted me-1"></i>Status
                                </label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" name="status" value="ativo" class="btn-check" id="btnradio1" {% if armazenagem.status == 'ativo' %}checked{% endif %}>
                                    <label class="btn btn-outline-success" for="btnradio1">
                                        Ativo
                                    </label>
                                    <input type="radio" name="status" value="inativo" class="btn-check" id="btnradio2" {% if armazenagem.status == 'inativo' %}checked{% endif %}>
                                    <label class="btn btn-outline-danger" for="btnradio2">
                                        Inativo
                                    </label>
                                    <input type="radio" name="status" value="manutencao" class="btn-check" id="btnradio3" {% if armazenagem.status == 'manutencao' %}checked{% endif %}>
                                    <label class="btn btn-outline-warning" for="btnradio3">
                                        Manutenção
                                    </label>
                                    <input type="radio" name="status" value="bloqueado" class="btn-check" id="btnradio4" {% if armazenagem.status == 'bloqueado' %}checked{% endif %}>
                                    <label class="btn btn-outline-dark" for="btnradio4">
                                        Bloqueado
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Observações -->
                    <div class="mb-4">
                        <h6 class="mb-3 fw-semibold text-primary">
                            <i class="fas fa-comment-alt me-2"></i>Observações
                        </h6>
                        <textarea class="form-control" name="observacoes" rows="4" placeholder="Informações adicionais sobre a localização de armazenagem (opcional)">{{ armazenagem.observacoes }}</textarea>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="{{ DOMAIN }}/armazenagens" class="btn btn-light btn-wave">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary btn-wave">
                            <i class="fas fa-save me-2"></i>Atualizar Armazenagem
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Fim::row -->
{% endblock %}

{% block scripts %}
{% include "components/partials/sweetalert.twig" %}
<script src="{{ PATH }}/view/assets/js/armazenagens/edit.js?v={{ VERSION }}"></script>
{% endblock %} 