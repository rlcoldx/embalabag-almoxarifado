{% extends "layout/layoutMaster.twig" %}

{% block title %}Nova Armazenagem - EmbalaBag{% endblock %}


{% block content %}
<!-- Início::page-header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Nova Armazenagem</p>
        <span class="fs-semibold text-muted">Adicione um novo local de armazenamento ao sistema.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/armazenagens" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-arrow-left me-2 align-middle d-inline-block"></i>Voltar para Armazenagens
        </a>
    </div>
</div>
<!-- Fim::page-header -->

<!-- Início::row -->
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header justify-content-between align-items-center">
                <div class="card-title">
                    <i class="fas fa-archive me-2"></i>Informações da Armazenagem
                </div>
            </div>
            <div class="card-body">
                <form id="formArmazenagem">
                    <!-- Localização e Identificação -->
                    <div class="mb-4">
                        <h6 class="mb-3 fw-semibold text-primary">
                            <i class="fas fa-map-marker-alt me-2"></i>Localização e Identificação
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label required">
                                    <i class="fas fa-building text-muted me-1"></i>Andar
                                </label>
                                <input type="text" class="form-control" name="setor" required autocomplete="off" placeholder="Ex: Andar 1, Andar 2, Andar 3">
                                <small class="form-text text-muted">Andar onde está localizado</small>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label required">
                                    <i class="fas fa-tag text-muted me-1"></i>Código
                                </label>
                                <input type="text" class="form-control" name="codigo" required autocomplete="off" placeholder="Ex: A01, PRAT-01">
                                <small class="form-text text-muted">Código único de identificação</small>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label required">
                                    <i class="fas fa-box text-muted me-1"></i>Tipo
                                </label>
                                <select class="form-select" name="tipo" required>
                                    <option value="">Selecione o tipo...</option>
                                    <option value="corredor">Corredor</option>
                                    <option value="prateleira">Prateleira</option>
                                    <option value="gaveta">Gaveta</option>
                                    <option value="caixa">Caixa</option>
                                    <option value="pallet">Pallet</option>
                                    <option value="area">Área</option>
                                </select>
                                <small class="form-text text-muted">Tipo de armazenagem</small>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <label class="form-label">
                                    <i class="fas fa-layer-group text-muted me-1"></i>Capacidade Máxima
                                </label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="capacidade_maxima" min="0" placeholder="0">
                                    <span class="input-group-text">Unidades</span>
                                </div>
                                <small class="form-text text-muted">Deixe em branco para capacidade ilimitada</small>
                            </div>
                        </div>
                    </div>

                    <!-- Características -->
                    <div class="mb-4">
                        <h6 class="mb-3 fw-semibold text-primary">
                            <i class="fas fa-info-circle me-2"></i>Características
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-9">
                                <label class="form-label required">
                                    <i class="fas fa-file-alt text-muted me-1"></i>Descrição
                                </label>
                                <input type="text" class="form-control" name="descricao" required autocomplete="off" placeholder="Ex: Prateleira A, Gaveta 01">
                                <small class="form-text text-muted">Nome descritivo da localização</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">
                                    <i class="fas fa-toggle-on text-muted me-1"></i>Status
                                </label>
                                <div class="btn-group w-100 mt-1" role="group">
                                    <input type="radio" name="status" value="ativo" class="btn-check" id="btnradio1" checked>
                                    <label class="btn btn-outline-success" for="btnradio1">
                                        <i class="fas fa-check-circle me-1"></i>Ativo
                                    </label>
                                    <input type="radio" name="status" value="inativo" class="btn-check" id="btnradio2">
                                    <label class="btn btn-outline-danger" for="btnradio2">
                                        <i class="fas fa-times-circle me-1"></i>Inativo
                                    </label>
                                    <input type="radio" name="status" value="manutencao" class="btn-check" id="btnradio3">
                                    <label class="btn btn-outline-warning" for="btnradio3">
                                        <i class="fas fa-tools me-1"></i>Manutenção
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Observações -->
                    <div class="mb-4">
                        <h6 class="mb-3 fw-semibold text-primary">
                            <i class="fas fa-comment-alt me-2"></i>Observações
                        </h6>
                        <textarea class="form-control" name="observacoes" rows="4" placeholder="Informações adicionais sobre a localização de armazenagem (opcional)"></textarea>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="{{ DOMAIN }}/armazenagens" class="btn btn-light btn-wave">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary btn-wave">
                            <i class="fas fa-save me-2"></i>Salvar Armazenagem
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Fim::row -->
{% endblock %}

{% block scripts %}
{% include "components/partials/sweetalert.twig" %}
<script src="{{ PATH }}/view/assets/js/armazenagens/create.js?v={{ VERSION }}"></script>
{% endblock %}