{% extends "layout/layoutMaster.twig" %}

{% block title %}Início - EmbalaBag{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ PATH }}/view/assets/css/home.css?v={{ VERSION }}">
{% endblock %}

{% block content %}
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        {% set nome = session[BASE ~ 'user_nome'] %}
        <p class="fw-semibold fs-18 mb-0">Bem-vindo de volta, {{ nome }}!</p>
        <span class="fs-semibold">Resumo geral do almoxarifado e notificações.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <button type="button" class="btn btn-primary btn-wave" id="btn-atualizar-home" onclick="window.location.reload()">
            <i class="fas fa-sync-alt me-2 align-middle d-inline-block"></i>Atualizar
        </button>
    </div>
</div>

{% set qtd_estoque_baixo = stats.produtos.estoque_baixo|default(0) %}
{% if qtd_estoque_baixo > 0 and (menu_permissions.estoque_baixo or menu_permissions.produtos) %}
<div class="home-estoque-alerta mb-4" role="alert">
    <div class="home-estoque-alerta__icone">
        <i class="fas fa-exclamation-triangle"></i>
    </div>
    <div class="home-estoque-alerta__texto">
        <p class="home-estoque-alerta__titulo mb-1">Atenção: estoque baixo</p>
        <p class="home-estoque-alerta__desc mb-0">
            {% if qtd_estoque_baixo == 1 %}
                <strong>1 produto</strong> está com estoque baixo e precisa de reposição.
            {% else %}
                <strong>{{ qtd_estoque_baixo }} produtos</strong> estão com estoque baixo e precisam de reposição.
            {% endif %}
        </p>
    </div>
    <div class="home-estoque-alerta__acao">
        <a href="{{ DOMAIN }}/produtos/estoque-baixo" class="btn btn-light btn-lg fw-semibold">
            <i class="fas fa-search me-2"></i>Verificar
        </a>
    </div>
</div>
{% endif %}

{% set alertas_of = stats.expedicao.alertas|default([]) %}
{% set encomendas_atrasadas = stats.expedicao.encomendas_atrasadas|default([]) %}
{% if alertas_of|length > 0 %}
<div class="alert alert-info mb-4">
    <p class="fw-semibold mb-2">OF vinculada a pedido</p>
    {% for alerta in alertas_of %}
    <p class="mb-1">
        {{ alerta.mensagem }}
        {% if alerta.pedido_codigo %}
        — <a href="{{ DOMAIN }}/pedidos/show/{{ alerta.pedido_id }}">{{ alerta.pedido_codigo }}</a>
        {% endif %}
    </p>
    {% endfor %}
</div>
{% endif %}
{% if encomendas_atrasadas|length > 0 %}
<div class="alert alert-warning mb-4">
    <p class="fw-semibold mb-2">Encomendas atrasadas</p>
    {% for item in encomendas_atrasadas %}
    <p class="mb-1">Pedido {{ item.pedido_codigo }} · {{ item.produto_nome }} · previsão {{ item.previsao }}</p>
    {% endfor %}
    <a href="{{ DOMAIN }}/expedicao/encomendas" class="btn btn-sm btn-warning btn-wave">Abrir encomendas</a>
</div>
{% endif %}

<div class="row home-stats-row">
    {% if menu_permissions.produtos or menu_permissions.dashboard_produtos %}
    <div class="col-xl-3 col-lg-6 col-md-6">
        <a href="{{ DOMAIN }}/dashboard/produtos" class="card custom-card home-card-link">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="avatar avatar-rounded bg-primary-transparent">
                            <i class="fas fa-boxes fs-18"></i>
                        </span>
                    </div>
                    <div class="flex-fill">
                        <h6 class="fw-semibold mb-0" id="contador-produtos-total">{{ stats.produtos.total|number_format(0, ',', '.') }}</h6>
                        <span class="home-card-label">Produtos</span>
                    </div>
                    <span class="badge bg-success-transparent">{{ stats.produtos.ativos|number_format(0, ',', '.') }} ativos</span>
                </div>
                <span class="home-card-cta">Ver estatísticas</span>
            </div>
        </a>
    </div>
    {% endif %}

    {% if menu_permissions.armazenagens or menu_permissions.dashboard_armazenagens %}
    <div class="col-xl-3 col-lg-6 col-md-6">
        <a href="{{ DOMAIN }}/dashboard/armazenagens" class="card custom-card home-card-link">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="avatar avatar-rounded bg-warning-transparent">
                            <i class="fas fa-warehouse fs-18"></i>
                        </span>
                    </div>
                    <div class="flex-fill">
                        <h6 class="fw-semibold mb-0" id="contador-armazenagens-total">{{ stats.armazenagens.total|number_format(0, ',', '.') }}</h6>
                        <span class="home-card-label">Armazenagens</span>
                    </div>
                    <span class="badge bg-info-transparent">{{ stats.armazenagens.percentual_ocupacao }}% ocupado</span>
                </div>
                <span class="home-card-cta">Ver estatísticas</span>
            </div>
        </a>
    </div>
    {% endif %}

    {% if menu_permissions.recebimento_dashboard %}
    <div class="col-xl-3 col-lg-6 col-md-6">
        <a href="{{ DOMAIN }}/recebimento/dashboard" class="card custom-card home-card-link">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="avatar avatar-rounded bg-success-transparent">
                            <i class="fas fa-truck fs-18"></i>
                        </span>
                    </div>
                    <div class="flex-fill">
                        <h6 class="fw-semibold mb-0">{{ stats.recebimentos.hoje|number_format(0, ',', '.') }}</h6>
                        <span class="home-card-label">Recebimentos hoje</span>
                    </div>
                    <span class="badge bg-warning-transparent">{{ stats.notas_fiscais.pendentes|number_format(0, ',', '.') }} pendentes</span>
                </div>
                <span class="home-card-cta">Ver estatísticas</span>
            </div>
        </a>
    </div>
    {% endif %}

    {% if menu_permissions.recebimento_movimentacoes or menu_permissions.dashboard_movimentacoes %}
    <div class="col-xl-3 col-lg-6 col-md-6">
        <a href="{{ DOMAIN }}/dashboard/movimentacoes" class="card custom-card home-card-link">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="avatar avatar-rounded bg-info-transparent">
                            <i class="fas fa-exchange-alt fs-18"></i>
                        </span>
                    </div>
                    <div class="flex-fill">
                        <h6 class="fw-semibold mb-0">{{ stats.movimentacoes.hoje|number_format(0, ',', '.') }}</h6>
                        <span class="home-card-label">Movimentações hoje</span>
                    </div>
                    <span class="badge bg-primary-transparent">{{ stats.movimentacoes.este_mes|number_format(0, ',', '.') }} no mês</span>
                </div>
                <span class="home-card-cta">Ver estatísticas</span>
            </div>
        </a>
    </div>
    {% endif %}
</div>

<div class="row">
    <div class="col-xl-7">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-bell me-2"></i>Notificações</div>
            </div>
            <div class="card-body">
                {% set notif_estoque = qtd_estoque_baixo > 0 and (menu_permissions.estoque_baixo or menu_permissions.produtos) %}
                {% set notif_nf = menu_permissions.recebimento_nf and stats.notas_fiscais.pendentes > 0 %}
                {% set notif_conf = menu_permissions.conferencia and stats.conferencias.pendentes > 0 %}
                {% set notif_pedidos = menu_permissions.pedidos and stats.pedidos.pendentes > 0 %}
                {% set notif_of = menu_permissions.expedicao and alertas_of|length > 0 %}
                {% set notif_encomenda = menu_permissions.encomendas and encomendas_atrasadas|length > 0 %}

                {% if notif_estoque %}
                    <a href="{{ DOMAIN }}/produtos/estoque-baixo" class="home-notif-item">
                        <span class="avatar avatar-sm avatar-rounded bg-danger-transparent">
                            <i class="fas fa-exclamation-triangle"></i>
                        </span>
                        <span class="flex-fill">
                            <strong>{{ qtd_estoque_baixo }}</strong>
                            {% if qtd_estoque_baixo == 1 %}produto com estoque baixo{% else %}produtos com estoque baixo{% endif %}
                        </span>
                        <span class="home-card-cta">Verificar</span>
                    </a>
                {% endif %}

                {% if notif_nf %}
                    <a href="{{ DOMAIN }}/recebimento/notas-fiscais" class="home-notif-item">
                        <span class="avatar avatar-sm avatar-rounded bg-warning-transparent">
                            <i class="fas fa-file-invoice"></i>
                        </span>
                        <span class="flex-fill">
                            <strong>{{ stats.notas_fiscais.pendentes }}</strong>
                            {% if stats.notas_fiscais.pendentes == 1 %}nota fiscal pendente{% else %}notas fiscais pendentes{% endif %}
                        </span>
                        <span class="home-card-cta">Abrir</span>
                    </a>
                {% endif %}

                {% if notif_conf %}
                    <a href="{{ DOMAIN }}/conferencia" class="home-notif-item">
                        <span class="avatar avatar-sm avatar-rounded bg-info-transparent">
                            <i class="fas fa-clipboard-check"></i>
                        </span>
                        <span class="flex-fill">
                            <strong>{{ stats.conferencias.pendentes }}</strong>
                            {% if stats.conferencias.pendentes == 1 %}conferência pendente{% else %}conferências pendentes{% endif %}
                        </span>
                        <span class="home-card-cta">Abrir</span>
                    </a>
                {% endif %}

                {% if notif_pedidos %}
                    <a href="{{ DOMAIN }}/pedidos" class="home-notif-item">
                        <span class="avatar avatar-sm avatar-rounded bg-primary-transparent">
                            <i class="fas fa-file-invoice"></i>
                        </span>
                        <span class="flex-fill">
                            <strong>{{ stats.pedidos.pendentes }}</strong>
                            {% if stats.pedidos.pendentes == 1 %}pedido pendente{% else %}pedidos pendentes{% endif %}
                        </span>
                        <span class="home-card-cta">Abrir</span>
                    </a>
                {% endif %}

                {% if notif_of %}
                    <a href="{{ DOMAIN }}/expedicao/aprovados" class="home-notif-item">
                        <span class="avatar avatar-sm avatar-rounded bg-info-transparent">
                            <i class="fas fa-file-import"></i>
                        </span>
                        <span class="flex-fill">
                            <strong>{{ alertas_of|length }}</strong>
                            OF direcionada a pedido
                        </span>
                        <span class="home-card-cta">Abrir</span>
                    </a>
                {% endif %}

                {% if notif_encomenda %}
                    <a href="{{ DOMAIN }}/expedicao/encomendas" class="home-notif-item">
                        <span class="avatar avatar-sm avatar-rounded bg-warning-transparent">
                            <i class="fas fa-clock"></i>
                        </span>
                        <span class="flex-fill">
                            <strong>{{ encomendas_atrasadas|length }}</strong>
                            encomenda(s) atrasada(s)
                        </span>
                        <span class="home-card-cta">Abrir</span>
                    </a>
                {% endif %}

                {% if not (notif_estoque or notif_nf or notif_conf or notif_pedidos or notif_of or notif_encomenda) %}
                    <p class="mb-0">Nenhuma notificação no momento.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-calendar-day me-2"></i>Hoje</div>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <span>Recebimentos</span>
                    <strong>{{ stats.recebimentos.hoje|number_format(0, ',', '.') }}</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span>Movimentações</span>
                    <strong>{{ stats.movimentacoes.hoje|number_format(0, ',', '.') }}</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Conferências</span>
                    <strong>{{ stats.conferencias.hoje|number_format(0, ',', '.') }}</strong>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="{{ DOMAIN }}/view/assets/js/home/home.js?v={{ VERSION }}"></script>
{% endblock %}
