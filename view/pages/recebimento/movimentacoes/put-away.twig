{% extends "layout/layoutMaster.twig" %}
{% block title %}Put-away - EmbalaBag{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Put-away</p>
        <span class="fs-semibold">Alocar item recebido em uma armazenagem de destino.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/recebimento/movimentacoes" class="btn btn-outline-secondary btn-wave">
            <i class="fas fa-arrow-left me-2"></i>Voltar
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-dolly me-2"></i>Alocar Item</div>
            </div>
            <div class="card-body">
                <form id="formMovimentacao" method="POST" action="{{ DOMAIN }}/recebimento/movimentacoes/put-away/store">
                    <input type="hidden" name="tipo_movimentacao" value="put_away">

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Nota Fiscal</label>
                            <select class="form-select" id="selectNotaFiscal">
                                <option value="">Todas as notas</option>
                                {% for nota in notas %}
                                <option value="{{ nota.id }}">NF {{ nota.numero }} — {{ nota.fornecedor|default('Sem fornecedor') }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Item da NF <span class="text-danger">*</span></label>
                            <select class="form-select" name="item_nf_id" id="selectItemNF" required>
                                <option value="">Selecione um item</option>
                                {% for item in itens %}
                                <option value="{{ item.id }}"
                                    data-nf="{{ item.nota_fiscal_id }}"
                                    data-qty="{{ item.quantidade }}"
                                    data-origem="{{ item.armazenagem_id|default('') }}"
                                    data-produto="{{ item.codigo_produto }} — {{ item.descricao_produto }}">
                                    NF {{ item.numero_nf }} · {{ item.codigo_produto }} — {{ item.descricao_produto }}
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Quantidade Disponível</label>
                            <input type="number" class="form-control" id="quantidadeDisponivel" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Quantidade a Alocar <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="quantidade_movimentada" id="quantidadeMovimentada" min="1" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Armazenagem de Destino <span class="text-danger">*</span></label>
                            <select class="form-select" name="armazenagem_destino_id" id="selectArmazenagemDestino" required>
                                <option value="">Selecione o destino</option>
                                {% for armazenagem in armazenagens %}
                                <option value="{{ armazenagem.id }}" data-capacidade="{{ armazenagem.capacidade_maxima|default(0) }}">
                                    {{ armazenagem.codigo }} — {{ armazenagem.descricao }}
                                    {% if armazenagem.capacidade_maxima %}
                                        ({{ armazenagem.capacidade_atual|default(0) }}/{{ armazenagem.capacidade_maxima }})
                                    {% endif %}
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Observações</label>
                            <textarea class="form-control" name="observacoes" rows="3" placeholder="Observações do put-away"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ DOMAIN }}/recebimento/movimentacoes" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-check me-1"></i>Realizar Put-away
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">Como funciona</div>
            </div>
            <div class="card-body">
                <p class="mb-2">O put-away registra a alocação do item recebido na posição escolhida.</p>
                <p class="mb-0">Ao confirmar, a movimentação é criada e executada, atualizando o status do item para alocado.</p>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/recebimento/movimentacoes/form.js?v={{ VERSION }}"></script>
{% endblock %}
