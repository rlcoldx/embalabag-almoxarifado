{% extends "layout/layoutMaster.twig" %}

{% block title %}Movimentações Internas - EmbalaBag{% endblock %}

{% block content %}
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Movimentações Internas</p>
        <span class="fs-semibold">Gerencie put-away, transferências e reposições de estoque.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        {% if permissions.can.movimentacoes.create %}
        <a href="{{ DOMAIN }}/recebimento/movimentacoes/put-away" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-dolly me-2 align-middle d-inline-block"></i>Put-away
        </a>
        <a href="{{ DOMAIN }}/recebimento/movimentacoes/transferencia" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-exchange-alt me-2 align-middle d-inline-block"></i>Transferência
        </a>
        <a href="{{ DOMAIN }}/recebimento/movimentacoes/create" class="btn btn-primary btn-wave">
            <i class="fas fa-plus me-2 align-middle d-inline-block"></i>Nova Movimentação
        </a>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        {% include 'components/partials/datatable.twig' with {
            table_name: 'movimentacoes',
            data_url: DOMAIN ~ '/datatable/movimentacoes',
            title: 'Lista de Movimentações',
            create_url: DOMAIN ~ '/recebimento/movimentacoes/create',
            show_create_button: false
        } %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/recebimento/movimentacoes/index.js?v={{ VERSION }}"></script>
{% endblock %}
