{% extends "layout/layoutMaster.twig" %}

{% block title %}Etiquetas Internas - EmbalaBag{% endblock %}

{% block content %}
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Etiquetas Internas</p>
        <span class="fs-semibold">Gerencie etiquetas de localização, palete e produto.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/recebimento/etiquetas/create" class="btn btn-primary btn-wave">
            <i class="fas fa-plus me-2 align-middle d-inline-block"></i>Nova Etiqueta
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        {% include 'components/partials/datatable.twig' with {
            table_name: 'etiquetas',
            data_url: DOMAIN ~ '/datatable/etiquetas',
            title: 'Lista de Etiquetas',
            create_url: DOMAIN ~ '/recebimento/etiquetas/create',
            show_create_button: false
        } %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/recebimento/etiquetas/index.js?v={{ VERSION }}"></script>
{% endblock %}
