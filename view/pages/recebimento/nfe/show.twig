{% extends "layout/layoutMaster.twig" %}
{% block title %}NF-e {{ nfe.numero_nfe }}{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">NF-e {{ nfe.numero_nfe }}</p>
        <span class="badge bg-{{ nfe.status == 'finalizada' ? 'success' : (nfe.status == 'conferida' ? 'info' : 'warning') }}-transparent">
            {{ nfe.status|capitalize }}
        </span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        {% if permissions.can.recebimento.edit %}
        <a href="{{ DOMAIN }}/recebimento/nfe/edit/{{ nfe.id }}" class="btn btn-outline-primary btn-wave me-2">
            <i class="fas fa-edit me-2"></i>Editar
        </a>
        {% endif %}
        <a href="{{ DOMAIN }}/recebimento/nfe" class="btn btn-outline-secondary btn-wave">
            <i class="fas fa-arrow-left me-2"></i>Voltar
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="card custom-card mb-4">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-info-circle me-2"></i>Informações da NF-e</div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Número</label>
                        <p class="mb-0 fs-16">{{ nfe.numero_nfe }}</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Chave de Acesso</label>
                        <p class="mb-0 fs-16">{{ nfe.chave_acesso }}</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Fornecedor</label>
                        <p class="mb-0 fs-16">{{ nfe.fornecedor_nome|default('-') }}</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Pedido Vinculado</label>
                        <p class="mb-0 fs-16">
                            {% if nfe.pedido_id %}
                            <a href="{{ DOMAIN }}/pedidos/show/{{ nfe.pedido_id }}" class="text-primary">{{ nfe.pedido_codigo|default(nfe.pedido_id) }}</a>
                            {% else %}
                            -
                            {% endif %}
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Data Emissão</label>
                        <p class="mb-0 fs-16">{{ nfe.data_emissao }}</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Data Recebimento</label>
                        <p class="mb-0 fs-16">{{ nfe.data_recebimento|default('-') }}</p>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-semibold">Observações</label>
                        <p class="mb-0 fs-16">{{ nfe.observacoes|default('Nenhuma observação') }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-box me-2"></i>Itens da NF-e</div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>SKU</th>
                                <th>Variação</th>
                                <th class="text-center">Qtd</th>
                                <th class="text-end">Valor Unit.</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if itens|length > 0 %}
                            {% for item in itens %}
                            <tr>
                                <td>{{ item.nome_produto|default('-') }}</td>
                                <td>{{ item.sku|default('-') }}</td>
                                <td>{{ item.tamanho|default('-') }} / {{ item.cor|default('-') }}</td>
                                <td class="text-center">{{ item.quantidade }}</td>
                                <td class="text-end">R$ {{ item.valor_unitario|number_format(2, ',', '.') }}</td>
                                <td class="text-end">R$ {{ item.valor_total|number_format(2, ',', '.') }}</td>
                            </tr>
                            {% endfor %}
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">Nenhum item nesta NF-e</td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-chart-bar me-2"></i>Resumo</div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Valor Total</label>
                    <p class="mb-0 fs-20 fw-semibold text-primary">R$ {{ nfe.valor_total|number_format(2, ',', '.') }}</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Recebido por</label>
                    <p class="mb-0 fs-16">{{ nfe.usuario_nome|default('-') }}</p>
                </div>
                <div class="mb-0">
                    <label class="form-label fw-semibold">Status</label>
                    <p class="mb-0">
                        <span class="badge bg-{{ nfe.status == 'finalizada' ? 'success' : (nfe.status == 'conferida' ? 'info' : 'warning') }}-transparent">
                            {{ nfe.status|capitalize }}
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
