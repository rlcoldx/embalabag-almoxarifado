{% extends "layout/layoutMaster.twig" %}
{% block title %}Notas Fiscais Eletrônicas{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Notas Fiscais Eletrônicas</p>
        <span class="fs-semibold">Gerencie NF-e de entrada vinculadas a pedidos e conferência.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/recebimento/nfe/create" class="btn btn-primary btn-wave me-2">
            <i class="fas fa-plus me-2"></i>Nova NF-e
        </a>
        <button type="button" class="btn btn-outline-primary btn-wave" id="btnNovaNfe">
            <i class="fas fa-file-invoice me-2"></i>Cadastro Rápido
        </button>
    </div>
</div>

<div class="card custom-card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="filtroStatus" class="form-label">Status</label>
                <select class="form-select" id="filtroStatus">
                    <option value="">Todos</option>
                    <option value="pendente">Pendente</option>
                    <option value="conferida">Conferida</option>
                    <option value="finalizada">Finalizada</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filtroFornecedor" class="form-label">Fornecedor</label>
                <select class="form-select" id="filtroFornecedor">
                    <option value="">Todos</option>
                    {% for fornecedor in fornecedores %}
                    <option value="{{ fornecedor.id }}">{{ fornecedor.nome }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="filtroDataInicio" class="form-label">Data Início</label>
                <input type="date" class="form-control" id="filtroDataInicio">
            </div>
            <div class="col-md-3">
                <label for="filtroDataFim" class="form-label">Data Fim</label>
                <input type="date" class="form-control" id="filtroDataFim">
            </div>
            <div class="col-md-3">
                <label for="filtroResponsavel" class="form-label">Responsável</label>
                <select class="form-select" id="filtroResponsavel">
                    <option value="">Todos</option>
                    {% for usuario in usuarios_responsaveis|default([]) %}
                    <option value="{{ usuario.id }}">{{ usuario.nome }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12">
                <button type="button" class="btn btn-secondary" id="btnAplicarFiltros">
                    <i class="fas fa-filter me-1"></i>Aplicar Filtros
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnLimparFiltros">
                    <i class="fas fa-times me-1"></i>Limpar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card custom-card">
    <div class="card-header">
        <div class="card-title">Lista de NF-e</div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover w-100" id="tabelaNfe">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fornecedor</th>
                        <th>Pedido</th>
                        <th>Emissão</th>
                        <th>Recebimento</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th>Responsável</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

{% include 'components/partials/modal-nfe-create.twig' %}

{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/recebimento/nfe.js?v={{ VERSION }}"></script>
<script>
$(document).ready(function() {
    const table = $('#tabelaNfe').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: buildUrl('/datatable/nfe'),
            type: 'POST',
            data: function(d) {
                d.status = $('#filtroStatus').val();
                d.fornecedor = $('#filtroFornecedor').val();
                d.data_inicio = $('#filtroDataInicio').val();
                d.data_fim = $('#filtroDataFim').val();
                d.usuario_recebimento_id = $('#filtroResponsavel').val();
            }
        },
        columns: [
            { data: 'numero_nfe' },
            { data: 'fornecedor_nome' },
            { data: 'numero_pedido', defaultContent: '-' },
            { data: 'data_emissao' },
            { data: 'data_recebimento' },
            {
                data: 'valor_total',
                render: function(data) {
                    return 'R$ ' + parseFloat(data || 0).toFixed(2).replace('.', ',');
                }
            },
            {
                data: 'status',
                render: function(data) {
                    const map = {
                        pendente: '<span class="badge bg-warning-transparent">Pendente</span>',
                        conferida: '<span class="badge bg-info-transparent">Conferida</span>',
                        finalizada: '<span class="badge bg-success-transparent">Finalizada</span>'
                    };
                    return map[data] || data;
                }
            },
            { data: 'usuario_nome' },
            {
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <div class="btn-group btn-group-sm">
                            <a href="${buildUrl('/recebimento/nfe/show/' + row.id)}" class="btn btn-outline-primary" title="Visualizar">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="${buildUrl('/recebimento/nfe/edit/' + row.id)}" class="btn btn-outline-warning" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger" title="Excluir" onclick="excluirNfe(${row.id})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    `;
                }
            }
        ],
        order: [[4, 'desc']],
        language: { url: buildUrl('/view/assets/js/datatables-pt-br.json') }
    });

    $('#btnAplicarFiltros').on('click', function() { table.ajax.reload(); });
    $('#btnLimparFiltros').on('click', function() {
        $('#filtroStatus, #filtroFornecedor, #filtroDataInicio, #filtroDataFim, #filtroResponsavel').val('');
        table.ajax.reload();
    });
});

function excluirNfe(id) {
    Swal.fire({
        title: 'Excluir NF-e?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sim, excluir',
        cancelButtonText: 'Cancelar'
    }).then(function(result) {
        if (!result.isConfirmed) return;

        fetch(buildUrl('/recebimento/nfe/delete/' + id), { method: 'POST' })
            .then(r => r.json())
            .then(function(response) {
                if (response.success) {
                    Swal.fire({ icon: 'success', title: 'Sucesso', text: response.message });
                    $('#tabelaNfe').DataTable().ajax.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Erro', text: response.error });
                }
            });
    });
}
</script>
{% endblock %}
