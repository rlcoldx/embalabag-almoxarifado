<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Relatório de Etiquetas</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 24px; color: #222; }
        h1 { font-size: 20px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 6px 8px; }
        th { background: #f5f5f5; }
    </style>
</head>
<body onload="window.print()">
    <h1>Relatório de Etiquetas</h1>
    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Tipo</th>
                <th>Status</th>
                <th>QR Code</th>
                <th>Data Criação</th>
            </tr>
        </thead>
        <tbody>
            {% for item in dados.dados|default([]) %}
            <tr>
                <td>{{ item.codigo|default('-') }}</td>
                <td>{{ item.tipo_etiqueta_descricao|default(item.tipo_etiqueta)|default('-') }}</td>
                <td>{{ item.status_descricao|default(item.status)|default('-') }}</td>
                <td>
                    {% if item.qr_code_image %}
                    <img src="{{ item.qr_code_image }}" alt="QR" style="width: 64px; height: 64px;">
                    {% else %}
                    {{ item.qr_code|default('-') }}
                    {% endif %}
                </td>
                <td>{{ item.data_criacao_formatada|default(item.created_at)|default('-') }}</td>
            </tr>
            {% else %}
            <tr><td colspan="5">Nenhum registro encontrado.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
