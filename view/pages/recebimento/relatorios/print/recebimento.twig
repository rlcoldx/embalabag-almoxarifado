<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Relatório de Recebimento</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 24px; color: #222; }
        h1 { font-size: 20px; margin-bottom: 8px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: left; }
        th { background: #f5f5f5; }
    </style>
</head>
<body onload="window.print()">
    <h1>Relatório de Recebimento</h1>
    <p>Período: {{ filtros.data_inicio|default('—') }} até {{ filtros.data_fim|default('—') }}</p>
    <table>
        <thead>
            <tr>
                <th>Número</th>
                <th>Fornecedor</th>
                <th>Data Emissão</th>
                <th>Status</th>
                <th>Valor Total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in dados.dados|default([]) %}
            <tr>
                <td>{{ item.numero|default('-') }}</td>
                <td>{{ item.fornecedor|default('-') }}</td>
                <td>{{ item.data_emissao|default('-') }}</td>
                <td>{{ item.status|default('-') }}</td>
                <td>{{ item.valor_total|default(0) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="5">Nenhum registro encontrado.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
