{% extends "layout/layoutMaster.twig" %}

{% block title %}Notas Fiscais - EmbalaBag{% endblock %}

{% block content %}
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Notas Fiscais</p>
        <span class="fs-semibold">Gerencie as notas fiscais recebidas no almoxarifado.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/recebimento/notas-fiscais/create" class="btn btn-primary btn-wave">
            <i class="fas fa-plus me-2 align-middle d-inline-block"></i>Nova Nota Fiscal
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        {% include 'components/partials/datatable.twig' with {
            table_name: 'notas-fiscais',
            data_url: DOMAIN ~ '/datatable/notas-fiscais',
            title: 'Lista de Notas Fiscais',
            create_url: DOMAIN ~ '/recebimento/notas-fiscais/create',
            show_create_button: false
        } %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/recebimento/notas-fiscais/index.js?v={{ VERSION }}"></script>
{% endblock %}
