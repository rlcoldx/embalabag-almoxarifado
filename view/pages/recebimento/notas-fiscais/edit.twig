{% extends "layout/layoutMaster.twig" %}

{% block title %}Editar Nota Fiscal - EmbalaBag{% endblock %}



{% block content %}
<!-- Início::page-header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Editar Nota Fiscal</p>
        <span class="fs-semibold">Edite as informações da nota fiscal.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/recebimento/notas-fiscais" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-arrow-left me-2 align-middle d-inline-block"></i>Voltar
        </a>
    </div>
</div>
<!-- Fim::page-header -->

<!-- Início::row -->
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    <h5 class="mb-0">Informações da Nota Fiscal</h5>
                </div>
            </div>
            <div class="card-body">
                <form id="formNotaFiscal" method="POST" action="{{ DOMAIN }}/recebimento/notas-fiscais/update/{{ nota_fiscal.id }}">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Número da NF-e <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="numero" value="{{ nota_fiscal.numero }}" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Série</label>
                            <input type="text" class="form-control" name="serie" value="{{ nota_fiscal.serie }}">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Data de Emissão <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="data_emissao" value="{{ nota_fiscal.data_emissao|date('Y-m-d') }}" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Valor Total</label>
                            <input type="number" class="form-control" name="valor_total" step="0.01" min="0" value="{{ nota_fiscal.valor_total }}">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">CNPJ do Fornecedor</label>
                            <input type="text" class="form-control" name="cnpj_fornecedor" value="{{ nota_fiscal.cnpj_fornecedor }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nome do Fornecedor <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="fornecedor" value="{{ nota_fiscal.fornecedor }}" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Pedido Relacionado</label>
                            <select class="form-select" name="pedido_id">
                                <option value="">Selecione um pedido</option>
                                {% for pedido in pedidos %}
                                <option value="{{ pedido.id }}" {{ nota_fiscal.pedido_id == pedido.id ? 'selected' : '' }}>{{ pedido.codigo|default(pedido.id) }} — {{ pedido.nome_cliente|default('') }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="status">
                                <option value="pendente" {{ nota_fiscal.status == 'pendente' ? 'selected' : '' }}>Pendente</option>
                                <option value="recebida" {{ nota_fiscal.status == 'recebida' ? 'selected' : '' }}>Recebida</option>
                                <option value="conferida" {{ nota_fiscal.status == 'conferida' ? 'selected' : '' }}>Conferida</option>
                                <option value="finalizada" {{ nota_fiscal.status == 'finalizada' ? 'selected' : '' }}>Finalizada</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="form-label">Chave de Acesso</label>
                            <input type="text" class="form-control" name="chave_acesso" value="{{ nota_fiscal.chave_acesso }}">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="form-label">Observações</label>
                            <textarea class="form-control" name="observacoes" rows="3">{{ nota_fiscal.observacoes }}</textarea>
                        </div>
                    </div>

                    <div class="row mb-3">
                        {% include 'components/partials/select-responsavel.twig' with {
                            field_name: 'usuario_recebimento',
                            field_label: 'Responsável pelo recebimento',
                            selected_id: nota_fiscal.usuario_recebimento,
                            required: true
                        } %}
                    </div>

                    <!-- Botões -->
                    <div class="row">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-wave">
                                <i class="fas fa-save me-2"></i>Atualizar Nota Fiscal
                            </button>
                            <a href="{{ DOMAIN }}/recebimento/notas-fiscais" class="btn btn-outline-secondary btn-wave">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Fim::row -->
{% endblock %} 