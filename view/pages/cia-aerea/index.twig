{% extends "layout/layoutMaster.twig" %}
{% block title %}Portal da cia aérea{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Portal da cia aérea</p>
        <span class="fs-semibold">{% if somente_companhia %}Romaneios enviados para a sua companhia.{% else %}Visão administrativa dos romaneios das companhias.{% endif %}</span>
    </div>
</div>

<div class="card custom-card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Romaneio</th>
                    <th>Companhia</th>
                    <th>Voo</th>
                    <th>Pedidos</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in romaneios %}
                <tr>
                    <td>{{ item.codigo }}</td>
                    <td>{{ item.companhia_empresa ?: item.companhia_nome ?: '-' }}</td>
                    <td>{{ item.voo|default('-') }}</td>
                    <td>{{ item.total_pedidos }}</td>
                    <td>{{ item.status }}</td>
                    <td class="text-end">
                        <a href="{{ DOMAIN }}/cia-aerea/romaneios/{{ item.id }}" class="btn btn-sm btn-primary btn-wave">Abrir</a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center py-4">Nenhum romaneio disponível.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
