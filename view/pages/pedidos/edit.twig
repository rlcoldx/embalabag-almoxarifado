{% extends "layout/layoutMaster.twig" %}
{% block title %}Editar Pedido {{ pedido.codigo }}{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Editar Pedido {{ pedido.codigo }}</p>
        <span class="fs-semibold">Atualize os dados e itens do pedido.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="{{ DOMAIN }}/pedidos/show/{{ pedido.id }}" class="btn btn-outline-primary btn-wave">
            <i class="fas fa-eye me-2"></i>Ver Detalhes
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-edit me-2"></i>Editar Pedido
                </div>
            </div>
            <div class="card-body">
                <form id="formPedido">
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label required">Fornecedor / Solicitante</label>
                            <input type="text" class="form-control" name="nome_cliente" required value="{{ pedido.nome_cliente }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Base Solicitante</label>
                            <input type="text" class="form-control" name="base_solicitante" value="{{ pedido.base_solicitante }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Base Destino</label>
                            <input type="text" class="form-control" name="base_destino" value="{{ pedido.base_destino }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Previsão de Entrega</label>
                            <input type="date" class="form-control" name="previsao_entrega" value="{{ pedido.previsao_entrega }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Prioridade</label>
                            <select class="form-select" name="prioridade">
                                <option value="Normal" {{ pedido.prioridade == 'Normal' ? 'selected' : '' }}>Normal</option>
                                <option value="Urgente" {{ pedido.prioridade == 'Urgente' ? 'selected' : '' }}>Urgente</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="status_pedido">
                                <option value="0" {{ pedido.status_pedido == '0' ? 'selected' : '' }}>Cancelado</option>
                                <option value="1" {{ pedido.status_pedido == '1' ? 'selected' : '' }}>Pendente</option>
                                <option value="2" {{ pedido.status_pedido == '2' ? 'selected' : '' }}>Aprovado</option>
                                <option value="3" {{ pedido.status_pedido == '3' ? 'selected' : '' }}>Em andamento</option>
                                <option value="4" {{ pedido.status_pedido == '4' ? 'selected' : '' }}>Em Preparação</option>
                                <option value="5" {{ pedido.status_pedido == '5' ? 'selected' : '' }}>Aguardando Retorno</option>
                                <option value="6" {{ pedido.status_pedido == '6' ? 'selected' : '' }}>Enviado</option>
                                <option value="7" {{ pedido.status_pedido == '7' ? 'selected' : '' }}>Disponível Retirada</option>
                                <option value="8" {{ pedido.status_pedido == '8' ? 'selected' : '' }}>Em Rota</option>
                                <option value="9" {{ pedido.status_pedido == '9' ? 'selected' : '' }}>Concluído</option>
                            </select>
                        </div>
                        {% include 'components/partials/select-responsavel.twig' with {
                            field_name: 'id_user',
                            field_label: 'Responsável',
                            selected_id: pedido.id_user,
                            required: true,
                            col_class: 'col-md-3'
                        } %}
                        <div class="col-md-12">
                            <label class="form-label">Observações</label>
                            <textarea class="form-control" name="observacoes" rows="2">{{ pedido.observacoes }}</textarea>
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6 class="fw-semibold text-primary mb-3">
                            <i class="fas fa-box me-2"></i>Itens do Pedido
                        </h6>
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-5">
                                <label class="form-label">Buscar produto</label>
                                <input type="text" class="form-control" id="buscaProduto" placeholder="SKU ou nome do produto" autocomplete="off">
                                <div id="resultadosProduto" class="list-group mt-1 position-absolute z-3 w-100" style="max-height: 200px; overflow-y: auto;"></div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Quantidade</label>
                                <input type="number" class="form-control" id="itemQty" min="1" value="1">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Valor Unit.</label>
                                <input type="number" class="form-control" id="itemValor" min="0" step="0.01" value="0">
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-outline-primary w-100" id="btnAdicionarItem" disabled>
                                    <i class="fas fa-plus me-1"></i>Adicionar Item
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered" id="tabelaItens">
                                <thead>
                                    <tr>
                                        <th>Produto</th>
                                        <th>SKU</th>
                                        <th class="text-center">Qtd</th>
                                        <th class="text-end">Valor Unit.</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Ações</th>
                                    </tr>
                                </thead>
                                <tbody id="itensBody"></tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="4" class="text-end">Total do Pedido:</th>
                                        <th class="text-end" id="totalPedido">R$ 0,00</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <input type="hidden" name="itens" id="itensJson" value="[]">

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ DOMAIN }}/pedidos/show/{{ pedido.id }}" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/pedidos/form.js?v={{ VERSION }}"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        initPedidoForm({
            mode: 'edit',
            storeUrl: buildUrl('/pedidos/update/{{ pedido.id }}'),
            initialItens: {{ itens|json_encode|raw }}
        });
    });
</script>
{% endblock %}
