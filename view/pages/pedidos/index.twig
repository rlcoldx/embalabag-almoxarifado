{% extends "layout/layoutMaster.twig" %}
{% block title %}Pedidos de Compra{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Pedidos de Compra</p>
        <span class="fs-semibold">Gerencie pedidos de compra e vinculação com notas fiscais.</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        {% if permissions.can.pedidos.create %}
        <a href="{{ DOMAIN }}/pedidos/create" class="btn btn-primary btn-wave">
            <i class="fas fa-plus me-2 align-middle d-inline-block"></i>Novo Pedido
        </a>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        {% include 'components/partials/datatable.twig' with {
            table_name: 'pedidos',
            data_url: DOMAIN ~ '/api/pedidos',
            title: 'Lista de Pedidos',
            create_url: DOMAIN ~ '/pedidos/create',
            show_create_button: false
        } %}
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/pedidos/index.js?v={{ VERSION }}"></script>
{% endblock %}
