{% extends "layout/layoutMaster.twig" %}
{% block title %}Romaneios{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Romaneios</p>
        <span class="fs-semibold">Transferência para a cia aérea e entre embalagem e cia.</span>
    </div>
    <a href="{{ DOMAIN }}/expedicao/romaneios/novo" class="btn btn-primary btn-wave">Novo romaneio</a>
</div>

<div class="card custom-card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Companhia</th>
                    <th>Voo</th>
                    <th>Pedidos</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in romaneios %}
                <tr>
                    <td>{{ item.codigo }}</td>
                    <td>{{ item.tipo == 'embalagem_cia' ? 'Embalagem ↔ Cia' : 'Cia aérea' }}</td>
                    <td>{{ item.companhia_empresa ?: item.companhia_nome ?: '-' }}</td>
                    <td>{{ item.voo|default('-') }}</td>
                    <td>{{ item.total_pedidos }}</td>
                    <td>{{ item.status }}</td>
                    <td class="text-end">
                        <a href="{{ DOMAIN }}/expedicao/romaneios/{{ item.id }}" class="btn btn-sm btn-primary btn-wave">Abrir</a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center py-4">Nenhum romaneio.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
