{% extends "layout/layoutMaster.twig" %}
{% block title %}Avarias{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Avarias</p>
        <span class="fs-semibold">Registro e tratamento de avarias de produto, endereço ou embalagem.</span>
    </div>
</div>

<div class="card custom-card mb-4">
    <div class="card-header"><div class="card-title">Registrar avaria</div></div>
    <div class="card-body">
        <form method="post" action="{{ DOMAIN }}/expedicao/avarias/salvar">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Produto</label>
                    <select name="produto_id" class="form-select">
                        <option value="">Opcional</option>
                        {% for produto in produtos %}
                        <option value="{{ produto.id }}">{{ produto.nome }} ({{ produto.SKU }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Endereço</label>
                    <select name="armazenagem_id" class="form-select">
                        <option value="">Opcional</option>
                        {% for endereco in enderecos %}
                        <option value="{{ endereco.id }}">{{ endereco.codigo }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Tipo</label>
                    <select name="tipo" class="form-select">
                        <option value="produto">Produto</option>
                        <option value="armazenagem">Endereço</option>
                        <option value="embalagem">Embalagem</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Severidade</label>
                    <select name="severidade" class="form-select">
                        <option value="baixa">Baixa</option>
                        <option value="media" selected>Média</option>
                        <option value="alta">Alta</option>
                        <option value="critica">Crítica</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Qtd afetada</label>
                    <input type="number" name="quantidade_afetada" class="form-control" value="0" min="0">
                </div>
                <div class="col-md-8 mb-3">
                    <label class="form-label">Descrição</label>
                    <input type="text" name="descricao" class="form-control" required>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Observações</label>
                    <input type="text" name="observacoes" class="form-control">
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-wave">Salvar avaria</button>
        </form>
    </div>
</div>

<div class="card custom-card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Tipo</th>
                    <th>Produto / endereço</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in avarias %}
                <tr>
                    <td>{{ item.data_ocorrencia }}</td>
                    <td>{{ item.tipo }} / {{ item.severidade }}</td>
                    <td>{{ item.produto_nome ?: item.endereco_codigo ?: '-' }}<br><small>{{ item.descricao }}</small></td>
                    <td>{{ item.status }}</td>
                    <td>
                        <form method="post" action="{{ DOMAIN }}/expedicao/avarias/{{ item.id }}/status" class="d-flex gap-1">
                            <select name="status" class="form-select form-select-sm">
                                <option value="em_analise" {% if item.status == 'em_analise' %}selected{% endif %}>Em análise</option>
                                <option value="resolvida" {% if item.status == 'resolvida' %}selected{% endif %}>Resolvida</option>
                                <option value="fechada" {% if item.status == 'fechada' %}selected{% endif %}>Fechada</option>
                            </select>
                            <input type="text" name="acao_corretiva" class="form-control form-control-sm" placeholder="Ação" value="{{ item.acao_corretiva }}">
                            <button type="submit" class="btn btn-sm btn-outline-primary">OK</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center py-4">Nenhuma avaria.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
