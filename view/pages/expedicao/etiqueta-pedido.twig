{% extends "layout/layoutMaster.twig" %}
{% block title %}Etiqueta {{ pedido.etiqueta_interna }}{% endblock %}
{% block styles %}
<style>
@media print {
    .page-header-breadcrumb, .app-sidebar, .app-header, footer, .no-print { display: none !important; }
}
.etiqueta-box { border: 2px solid #222; padding: 24px; text-align: center; max-width: 360px; }
</style>
{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Etiqueta interna do pedido</p>
        <span class="fs-semibold">{{ pedido.codigo }}</span>
    </div>
    <div class="no-print">
        <button type="button" class="btn btn-primary btn-wave" onclick="window.print()">Imprimir</button>
        <a href="{{ DOMAIN }}/pedidos/show/{{ pedido.id }}" class="btn btn-outline-secondary btn-wave">Voltar</a>
    </div>
</div>

<div class="etiqueta-box">
    {% if qr_code %}
    <img src="{{ qr_code }}" alt="QR" width="180" height="180">
    {% endif %}
    <p class="fw-semibold fs-18 mb-1">{{ pedido.etiqueta_interna }}</p>
    <p class="mb-1">Pedido {{ pedido.codigo }}</p>
    <p class="mb-1">SIGE: {{ pedido.codigoSige|default('-') }}</p>
    <p class="mb-0">Destino: {{ pedido.base_destino|default('-') }}</p>
</div>

{% endblock %}
