{% extends "layout/layoutMaster.twig" %}
{% block title %}Conferência de saída {{ pedido.codigo }}{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Conferência de saída — {{ pedido.codigo }}</p>
        <span class="fs-semibold">Bipe o pedido SIGE, o destino e os itens.</span>
    </div>
    <a href="{{ DOMAIN }}/expedicao/conferencia" class="btn btn-outline-secondary btn-wave">Voltar</a>
</div>

<div id="expedicao-msg" class="alert d-none"></div>

<div class="row">
    <div class="col-xl-5">
        <div class="card custom-card mb-4">
            <div class="card-header"><div class="card-title">Bipar código</div></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Tipo</label>
                    <select id="conf-tipo" class="form-select">
                        <option value="sige">Pedido SIGE / etiqueta interna</option>
                        <option value="destino">Destino / etiqueta cia aérea</option>
                        <option value="item">Item</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Código</label>
                    <input type="text" id="conf-codigo" class="form-control" autofocus placeholder="Bipe ou digite">
                </div>
                <p class="mb-3">Esperado SIGE: <strong>{{ pedido.codigoSige|default(pedido.codigo) }}</strong> · Destino: <strong>{{ pedido.base_destino|default('-') }}</strong> · Cia: <strong>{{ pedido.etiqueta_cia_aerea|default('-') }}</strong></p>
                <button type="button" class="btn btn-primary btn-wave" id="btn-conferir" data-pedido-id="{{ pedido.id }}">Conferir</button>
            </div>
        </div>
    </div>
    <div class="col-xl-7">
        <div class="card custom-card mb-4">
            <div class="card-header"><div class="card-title">Leituras</div></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr><th>Tipo</th><th>Código</th><th>Quando</th></tr>
                    </thead>
                    <tbody>
                        {% for leitura in leituras %}
                        <tr>
                            <td>{{ leitura.tipo }}</td>
                            <td>{{ leitura.codigo_lido }}</td>
                            <td>{{ leitura.created_at }}</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="3" class="text-center py-3">Nenhuma leitura ainda.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <form method="post" action="{{ DOMAIN }}/expedicao/conferencia/concluir/{{ pedido.id }}" class="text-end">
            <button type="submit" class="btn btn-success btn-wave">Concluir e ir ao romaneio</button>
        </form>
    </div>
</div>

{% endblock %}
{% block scripts %}
<script src="{{ PATH }}/view/assets/js/expedicao/expedicao.js?v={{ VERSION }}"></script>
{% endblock %}
