{% extends "layout/layoutMaster.twig" %}
{% block title %}{{ titulo }} {{ pedido.codigo }}{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">{{ titulo }} — {{ pedido.codigo }}</p>
        <span class="fs-semibold">{{ texto }}</span>
    </div>
    <a href="{{ DOMAIN }}/expedicao" class="btn btn-outline-secondary btn-wave">Voltar</a>
</div>

<div class="card custom-card">
    <div class="card-header">
        <div class="card-title">Itens do pedido</div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>SKU</th>
                        <th>Qtd</th>
                        <th>Endereço</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in itens %}
                    <tr>
                        <td>{{ item.produto_nome|default('-') }}</td>
                        <td>{{ item.produto_sku|default('-') }}</td>
                        <td>{{ item.quantidade }}</td>
                        <td>{{ item.endereco_novo ?: item.endereco_origem ?: '-' }}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="4" class="text-center py-4">Sem itens.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-end">
        <form method="post" action="{{ acao }}">
            <button type="submit" class="btn btn-primary btn-wave">{{ acao_label }}</button>
        </form>
    </div>
</div>

{% endblock %}
