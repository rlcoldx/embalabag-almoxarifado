{% extends "layout/layoutMaster.twig" %}
{% block title %}Romaneio {{ romaneio.codigo }}{% endblock %}
{% block styles %}
<style>
@media print {
    .page-header-breadcrumb, .app-sidebar, .app-header, footer, .no-print { display: none !important; }
}
</style>
{% endblock %}
{% block content %}

<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Romaneio {{ romaneio.codigo }}</p>
        <span class="fs-semibold">{{ romaneio.tipo == 'embalagem_cia' ? 'Embalagem ↔ Cia aérea' : 'Cia aérea' }} · {{ romaneio.status }}</span>
    </div>
    <div class="no-print">
        <a href="{{ DOMAIN }}/expedicao/romaneios/{{ romaneio.id }}/imprimir" class="btn btn-outline-primary btn-wave me-2" onclick="window.print(); return false;">Imprimir</a>
        {% if not portal_cia and romaneio.status == 'aberto' %}
        <form method="post" action="{{ DOMAIN }}/expedicao/romaneios/{{ romaneio.id }}/enviar" class="d-inline">
            <button type="submit" class="btn btn-success btn-wave me-2">Marcar enviado</button>
        </form>
        {% endif %}
        {% if portal_cia and romaneio.status == 'enviado' %}
        <form method="post" action="{{ DOMAIN }}/cia-aerea/romaneios/{{ romaneio.id }}/receber" class="d-inline">
            <button type="submit" class="btn btn-success btn-wave me-2">Confirmar recebimento</button>
        </form>
        {% endif %}
        <a href="{{ portal_cia ? DOMAIN ~ '/cia-aerea' : DOMAIN ~ '/expedicao/romaneios' }}" class="btn btn-outline-secondary btn-wave">Voltar</a>
    </div>
</div>

<div class="card custom-card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-2"><strong>Companhia</strong><br>{{ romaneio.companhia_empresa ?: romaneio.companhia_nome ?: '-' }}</div>
            <div class="col-md-3 mb-2"><strong>Voo</strong><br>{{ romaneio.voo|default('-') }}</div>
            <div class="col-md-3 mb-2"><strong>Destino</strong><br>{{ romaneio.base_destino|default('-') }}</div>
            <div class="col-md-3 mb-2"><strong>Envio</strong><br>{{ romaneio.data_envio|default('-') }}</div>
        </div>
        {% if romaneio.observacoes %}
        <p class="mt-3 mb-0">{{ romaneio.observacoes }}</p>
        {% endif %}
    </div>
</div>

<div class="card custom-card">
    <div class="card-header"><div class="card-title">Pedidos</div></div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>SIGE</th>
                    <th>Destino</th>
                    <th>Etiqueta interna</th>
                    <th>Etiqueta cia</th>
                </tr>
            </thead>
            <tbody>
                {% for item in itens %}
                <tr>
                    <td>{{ item.codigo }}</td>
                    <td>{{ item.codigoSige|default('-') }}</td>
                    <td>{{ item.base_destino|default('-') }}</td>
                    <td>{{ item.etiqueta_interna|default('-') }}</td>
                    <td>{{ item.etiqueta_cia_aerea|default('-') }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center py-4">Sem pedidos.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
