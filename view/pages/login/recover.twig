{% extends "layout/layoutLogin.twig" %}
{% block content %}
<div class="row authentication mx-0">
    <div class="col-xxl-7 col-xl-7 col-lg-12">
        <div class="row justify-content-center align-items-center h-100">
            <div class="col-xxl-6 col-xl-7 col-lg-7 col-md-7 col-sm-8 col-12">
                <div class="p-5">
                    <div class="mb-3 text-center">
                        <img src="{{ DOMAIN }}/view/assets/ynex/assets/images/brand-logos/logo-on-light.svg" alt="Logo" class="authentication-brand desktop-logo img-fluid">
                        <img src="{{ DOMAIN }}/view/assets/ynex/assets/images/brand-logos/logo.svg" alt="Logo" class="authentication-brand desktop-dark img-fluid">
                    </div>
                    <p class="mb-1 fw-semibold fs-18">Recuperar senha</p>
                    <p class="mb-3 fw-normal">Informe o e-mail da sua conta. Se ele estiver cadastrado, enviaremos as instruções.</p>
                    <form id="recoverForm" action="javascript:void(0);" method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label text-default">E-mail</label>
                            <input type="email" class="form-control form-control-lg" id="email" name="email" placeholder="Digite seu e-mail" required>
                        </div>
                        <div class="d-grid mt-2">
                            <button type="submit" class="btn btn-lg btn-primary" id="recoverBtn">
                                <span class="btn-text">Enviar instruções</span>
                                <span class="btn-loading d-none">
                                    <i class="fas fa-spinner fa-spin me-2"></i>Enviando...
                                </span>
                            </button>
                        </div>
                    </form>
                    <div id="recoverError" class="mt-3 alert alert-danger d-none"></div>
                    <div id="recoverSuccess" class="mt-3 alert alert-success d-none"></div>
                    <div class="mt-4 text-center">
                        <a href="{{ DOMAIN }}/login">Voltar ao login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-5 col-xl-5 col-lg-5 d-xl-block d-none px-0">
        <div class="authentication-cover">
            <div class="aunthentication-cover-content rounded">
                <div class="text-fixed-white text-center p-5 d-flex align-items-center justify-content-center h-100">
                    <div>
                        <h6 class="fw-semibold text-fixed-white">Recuperação de acesso</h6>
                        <p class="fw-normal fs-14 op-7">O link de redefinição vale por 1 hora e só pode ser usado uma vez.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/login/recover.js?v={{ VERSION }}"></script>
{% endblock %}
