{% extends "layout/layoutLogin.twig" %}
{% block content %}
<div class="row authentication mx-0">
    <div class="col-xxl-7 col-xl-7 col-lg-12">
        <div class="row justify-content-center align-items-center h-100">
            <div class="col-xxl-6 col-xl-7 col-lg-7 col-md-7 col-sm-8 col-12">
                <div class="p-5">
                    <div class="mb-3 text-center">
                        <img src="{{ DOMAIN }}/view/assets/ynex/assets/images/brand-logos/logo-on-light.svg" alt="Logo" class="authentication-brand desktop-logo img-fluid">
                        <img src="{{ DOMAIN }}/view/assets/ynex/assets/images/brand-logos/logo.svg" alt="Logo" class="authentication-brand desktop-dark img-fluid">
                    </div>
                    {% if token_invalido %}
                        <p class="mb-1 fw-semibold fs-18">Link inválido</p>
                        <p class="mb-3 fw-normal">Este link de redefinição é inválido ou já expirou.</p>
                        <div class="d-grid">
                            <a href="{{ DOMAIN }}/login/recover" class="btn btn-lg btn-primary">Solicitar novo link</a>
                        </div>
                        <div class="mt-4 text-center">
                            <a href="{{ DOMAIN }}/login">Voltar ao login</a>
                        </div>
                    {% else %}
                        <p class="mb-1 fw-semibold fs-18">Nova senha</p>
                        <p class="mb-3 fw-normal">Defina uma senha com no mínimo 6 caracteres.</p>
                        <form id="resetForm" action="javascript:void(0);" method="post">
                            <input type="hidden" name="token" value="{{ token }}">
                            <div class="mb-3">
                                <label for="password" class="form-label text-default">Nova senha</label>
                                <div class="input-group">
                                    <input type="password" class="form-control form-control-lg" id="password" name="password" minlength="6" required>
                                    <button class="btn btn-light" type="button" onclick="createpassword('password',this)"><i class="fas fa-eye-slash align-middle"></i></button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="password_confirm" class="form-label text-default">Confirmar senha</label>
                                <input type="password" class="form-control form-control-lg" id="password_confirm" name="password_confirm" minlength="6" required>
                            </div>
                            <div class="d-grid mt-2">
                                <button type="submit" class="btn btn-lg btn-primary" id="resetBtn">
                                    <span class="btn-text">Salvar nova senha</span>
                                    <span class="btn-loading d-none">
                                        <i class="fas fa-spinner fa-spin me-2"></i>Salvando...
                                    </span>
                                </button>
                            </div>
                        </form>
                        <div id="resetError" class="mt-3 alert alert-danger d-none"></div>
                        <div id="resetSuccess" class="mt-3 alert alert-success d-none"></div>
                        <div class="mt-4 text-center">
                            <a href="{{ DOMAIN }}/login">Voltar ao login</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-5 col-xl-5 col-lg-5 d-xl-block d-none px-0">
        <div class="authentication-cover">
            <div class="aunthentication-cover-content rounded">
                <div class="text-fixed-white text-center p-5 d-flex align-items-center justify-content-center h-100">
                    <div>
                        <h6 class="fw-semibold text-fixed-white">Redefinir senha</h6>
                        <p class="fw-normal fs-14 op-7">Após salvar, você poderá entrar com a nova senha.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ PATH }}/view/assets/js/login/reset.js?v={{ VERSION }}"></script>
{% endblock %}
